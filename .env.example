# Copy to .env (untracked). Both paths stay outside the repository.
# Directory holding the sealed Windows 7 base image, its manifest, targets.json,
# clone overlays and the Linux appliance images.
ONE_VM_HOME=/absolute/path/to/OneNote VMs
# Licensed Windows 7 installation media, opened read-only by `vm.py install`.
ONE_WIN7_ISO=/absolute/path/to/Windows 7 Professional.ISO
