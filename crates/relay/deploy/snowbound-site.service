# /etc/systemd/system/snowbound-site.service: snowbound.paperclover.net, the hosted web build
# and the codes' pages, behind a TLS proxy on this machine (README.md). Options go on
# ExecStart, or as SNOWBOUND_SITE_* in Environment.
[Unit]
Description=Snowbound web build and Live Share links
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/snowbound-site --listen 127.0.0.1:23593 --root /srv/snowbound/web
Restart=always
RestartSec=2
DynamicUser=yes
TasksMax=200
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/srv/snowbound/web
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
